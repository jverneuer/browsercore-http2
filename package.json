{
  "name": "@browsercore/http2",
  "version": "0.1.3",
  "description": "HTTP/2 framing over any duplex byte stream. No knowledge of TLS or TCP \u2014 only HPACK + framing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jverneuer/browsercore-http2.git"
  },
  "homepage": "https://github.com/jverneuer/browsercore-http2#readme",
  "bugs": {
    "url": "https://github.com/jverneuer/browsercore-http2/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@browsercore/crypto": "latest",
    "@browsercore/transport": "latest"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
